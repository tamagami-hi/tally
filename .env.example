# Copy this file to .env and fill it in. Compose reads .env from this folder.

# The user the service runs as: yours, so every file and commit it writes is yours.
# Print them with: id -u ; id -g
TALLY_UID=1000
TALLY_GID=1000

# The one folder that holds every repository tally may track. It is mounted at
# the same path inside the container, and only repositories under it can be added.
TALLY_WORKSPACE=/home/you/projects

# Your global git config, mounted read-only, so the service's git ignores and
# filters what yours does. The file must exist: create an empty one if you have none.
TALLY_GITCONFIG=/home/you/.gitconfig

# The identity for the commits of a repository that has no user.name and
# user.email of its own. Leave empty to require each repository to have one.
TALLY_GIT_NAME=
TALLY_GIT_EMAIL=

# The port on this machine's loopback address. The board is http://127.0.0.1:<port>/
# and agents connect to http://127.0.0.1:<port>/mcp
TALLY_PORT=47560
