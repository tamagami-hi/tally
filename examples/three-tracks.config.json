{
  "schema": 1,
  "name": "Example",
  "mainBranch": "main",
  "docsDir": "docs",
  "tracks": [
    { "name": "alpha", "worktree": ".temp/worktrees/alpha", "branch": "track/alpha" },
    { "name": "beta", "worktree": ".temp/worktrees/beta", "branch": "track/beta" },
    { "name": "gamma", "worktree": ".temp/worktrees/gamma", "branch": "track/gamma" }
  ],
  "stages": [
    { "id": "A", "name": "the first slice", "weight": 30 },
    { "id": "B", "name": "widening", "weight": 50 },
    { "id": "C", "name": "later", "weight": 20 }
  ],
  "commands": {
    "test": ["cargo", "test", "--locked"],
    "env": { "TEST_DATABASE_URL": "postgres://tester:change-me@127.0.0.1:5432/tests" },
    "unset": ["CARGO_TARGET_DIR"],
    "tmpdir": ".temp/{track}/tmp"
  },
  "fingerprint": {
    "paths": ["src", "tests", "Cargo.toml", "Cargo.lock"],
    "exclude": ["*.md"]
  },
  "identity": { "name": "your-name", "email": "you@example.com" },
  "records": { "dir": "docs/records", "commitPrefix": "records:", "commit": true },
  "locks": ["landing", "checks"]
}
